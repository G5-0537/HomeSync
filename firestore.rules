rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/householdMembers/$(householdId + '_' + request.auth.uid)) ||
        get(/databases/$(database)/documents/households/$(householdId)).data.primaryTenantUid == request.auth.uid ||
        get(/databases/$(database)/documents/households/$(householdId)).data.landlordUid == request.auth.uid
      );
    }

    function isPartyToAgreement(agreementId) {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/rentalAgreements/$(agreementId)).data.tenantUid == request.auth.uid ||
        get(/databases/$(database)/documents/rentalAgreements/$(agreementId)).data.landlordUid == request.auth.uid
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      allow delete: if false;
    }

    // Properties Marketplace
    match /properties/{propertyId} {
      allow read: if true; // Public property discovery
      allow create: if isAuthenticated() && request.resource.data.landlordUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.landlordUid == request.auth.uid;
    }

    // Rental Applications
    match /rentalApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.tenantUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.tenantUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.tenantUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid
      );
    }

    // Rental Agreements
    match /rentalAgreements/{agreementId} {
      allow read: if isAuthenticated() && (
        resource.data.tenantUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.tenantUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid
      );
    }

    // Households
    match /households/{householdId} {
      allow read: if isAuthenticated() && (
        resource.data.primaryTenantUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid ||
        isHouseholdMember(householdId)
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.primaryTenantUid == request.auth.uid ||
        resource.data.landlordUid == request.auth.uid
      );
    }

    // Household Members
    match /householdMembers/{memberDocId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Expenses & Splits (Household data isolation)
    match /expenses/{expenseId} {
      allow read: if isAuthenticated() && isHouseholdMember(resource.data.householdId);
      allow create: if isAuthenticated() && 
        isHouseholdMember(request.resource.data.householdId) &&
        request.resource.data.amount > 0 &&
        request.resource.data.paidByUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.paidByUid == request.auth.uid ||
        isHouseholdMember(resource.data.householdId)
      );
    }

    // Settlements
    match /settlements/{settlementId} {
      allow read: if isAuthenticated() && isHouseholdMember(resource.data.householdId);
      allow create: if isAuthenticated() && isHouseholdMember(request.resource.data.householdId);
      allow update: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // Rent Payments
    match /rentPayments/{paymentId} {
      allow read: if isAuthenticated() && isHouseholdMember(resource.data.householdId);
      allow create, update: if isAuthenticated() && isHouseholdMember(request.resource.data.householdId);
    }

    // Security Deposits & Wallets
    match /securityDeposits/{depositId} {
      allow read: if isAuthenticated() && isPartyToAgreement(resource.data.agreementId);
      allow write: if isAuthenticated() && isPartyToAgreement(request.resource.data.agreementId);
    }

    // Property Condition Inspections
    match /inspections/{inspectionId} {
      allow read: if isAuthenticated() && isHouseholdMember(resource.data.householdId);
      allow create, update: if isAuthenticated() && isHouseholdMember(request.resource.data.householdId);
    }

    // Inventory & Shopping List Items
    match /inventoryItems/{itemId} {
      allow read: if isAuthenticated() && isHouseholdMember(resource.data.householdId);
      allow create, update, delete: if isAuthenticated() && isHouseholdMember(request.resource.data.householdId);
    }

    // Chores & Assignments
    match /chores/{choreId} {
      allow read: if isAuthenticated() && isHouseholdMember(resource.data.householdId);
      allow create, update, delete: if isAuthenticated() && isHouseholdMember(request.resource.data.householdId);
    }

    // Maintenance Requests
    match /maintenanceRequests/{requestId} {
      allow read: if isAuthenticated() && (
        isHouseholdMember(resource.data.householdId) ||
        resource.data.tenantUid == request.auth.uid
      );
      allow create: if isAuthenticated() && isHouseholdMember(request.resource.data.householdId);
      allow update: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // AI Conversations & Action Logs
    match /aiConversations/{convId} {
      allow read, write: if isAuthenticated();
    }
    match /aiActionLogs/{logId} {
      allow read, write: if isAuthenticated();
    }
  }
}
